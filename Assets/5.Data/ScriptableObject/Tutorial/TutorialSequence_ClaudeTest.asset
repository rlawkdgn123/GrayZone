    - m_dialogue:
        m_speaker: {fileID: 11400000, guid: a55c7497ba968c5459b0a6ed9a1d9b44, type: 2}
        m_portrait: {fileID: 0}
        m_text: "[\uD14C\uC2A4\uD2B8] \uC785\uB825 \uB300\uC0AC 2. \uB9D0\uD48D\uC120\uC5D0\uB294
          \uC9E7\uC740 \uBB38\uAD6C\uAC00 \uB530\uB85C \uB5A0."
        m_bubbleText: "[\uD14C\uC2A4\uD2B8] \uC9E7\uC740 \uBB38\uAD6C!"
        m_advanceMode: 0
        m_autoSeconds: 0
      m_condition: 0
      m_seconds: 0
      m_actions: []
    - m_dialogue:
        m_speaker: {fileID: 11400000, guid: 8d0183333193b184982890475792c01b, type: 2}
        m_portrait: {fileID: 0}
        m_text: "[\uD14C\uC2A4\uD2B8] \uC258\uD130 \uB9AC\uB354 \uB300\uC0AC\uC57C.
          \uAE30\uC9C0 NPC\uB77C \uB9D0\uD48D\uC120 \uC5C6\uC774 \uB300\uD654\uCC3D\uB9CC
          \uB728\uACE0, \uB300\uC0AC\uAC00 \uAE38\uBA74 \uC774\uB807\uAC8C \uC544\uB798\uB85C
          \uC904\uC774 \uBC14\uB00C\uBA74\uC11C \uBC30\uACBD \uB760\uB3C4 \uAC19\uC774
          \uB298\uC5B4\uB098."
        m_bubbleText: 
        m_advanceMode: 0
        m_autoSeconds: 0
      m_condition: 0
      m_seconds: 0
      m_actions: []
  - m_label: "\uC870\uAC74\uACFC \uC774\uBCA4\uD2B8 \uD655\uC778"
