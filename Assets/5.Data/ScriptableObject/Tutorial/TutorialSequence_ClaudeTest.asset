        m_speaker: {fileID: 11400000, guid: fa16a7b9b135b5748a5b984be5039028, type: 2}
        m_portrait: {fileID: 0}
        m_text: "[\uD14C\uC2A4\uD2B8] \uC785\uB825 \uB300\uC0AC 1. \uD074\uB9AD\uC774\uB098
