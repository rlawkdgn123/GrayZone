        m_portrait: {fileID: 0}
        m_text: "[\uD14C\uC2A4\uD2B8] \uC774 \uC904\uC740 \uB72C \uB4A4 3\uCD08\uAC00
          \uC9C0\uB098\uC57C \uB118\uC5B4\uAC00. \uB118\uC5B4\uAC00\uBA74 \uBBF8\uC158
